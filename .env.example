# ==============================================================================
# COMO CONFIGURAR ESTE ARQUIVO:
# 1. Copie este arquivo e renomeie a cópia exatamente para: .env
# 2. Abra o novo arquivo .env em qualquer editor de texto.
# 3. Troque cada valor falso pelo seu valor real correspondente (sem aspas,
#    sem espaços ao redor do sinal de igual, apenas o texto ou número).
# 4. Salve o arquivo e NUNCA o envie para ninguém ou para o GitHub.
# ==============================================================================

# ==============================================================================
# CREDENCIAIS OBRIGATÓRIAS
# ==============================================================================

# 1) Token de autenticação do bot
# Onde encontrar: Discord Developer Portal > sua aplicação > Bot > botão "Reset Token" (ou "Copy")
# Status: Obrigatório
# Exemplo: MTU1NjExMTE3NzY1Njk2MzE3Mg.Falso.TokenDeExemploParaOArquivo
DISCORD_TOKEN=SEU_TOKEN_AQUI_NUNCA_COMPARTILHE

# 2) ID do seu servidor (Guild) do Discord
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no ícone do servidor e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
GUILD_IDS=000000000000000000


# ==============================================================================
# CONFIGURAÇÕES DE CANAIS E CATEGORIAS OBRIGATÓRIAS
# ==============================================================================

# 1) ID do canal de texto onde os Logs dos Tickets serão enviados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
LOG_CHANNEL_ID=000000000000000000

# 2) ID da categoria onde os tickets de "Troca de Nome" serão criados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito na categoria e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
TICKET_CATEGORY_NOME_ID=000000000000000000

# 3) ID da categoria onde os tickets de "Certidão" serão criados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito na categoria e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
TICKET_CATEGORY_CERTIDAO_ID=000000000000000000

# 4) ID da categoria onde os tickets de "Porte de Arma" serão criados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito na categoria e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
TICKET_CATEGORY_PORTE_ID=000000000000000000

# 5) ID da categoria onde os tickets de "Abertura de Processo" serão criados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito na categoria e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
TICKET_CATEGORY_PROCESSO_ID=000000000000000000

# 6) ID da categoria onde os tickets de "Abertura de CNPJ" serão criados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito na categoria e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
TICKET_CATEGORY_CNPJ_ID=000000000000000000

# 7) ID da categoria onde os tickets de "Registro de Patente" serão criados
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito na categoria e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
TICKET_CATEGORY_PATENTE_ID=000000000000000000


# ==============================================================================
# CONFIGURAÇÕES DE CARGOS (ROLES) OBRIGATÓRIOS
# ==============================================================================

# 1) ID do cargo de Administrador (Garante acesso geral ao bot)
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo em Config. do Servidor > Cargos e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
ADMIN_ROLE_ID=000000000000000000

# 2) ID do cargo de Recrutador (Pode aceitar/recusar registros)
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
RECRUTADOR_ROLE_ID=000000000000000000

# 3) IDs dos cargos de Advertência (ADV 1, 2 e 3)
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 123456789012345678
ADV_1_ID=000000000000000000
ADV_2_ID=000000000000000000
ADV_3_ID=000000000000000000

# 4) IDs dos cargos relacionados ao registro de Advogados (ex: Estagiários). 
# Caso tenha mais de um, separe por vírgula e espaço.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 111111111111111111, 222222222222222222
CARGO_ESTAGIARIO_ID=000000000000000000

# 5) IDs dos cargos relacionados à Segurança do Tribunal. 
# Caso tenha mais de um, separe por vírgula e espaço.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo e escolha Copiar ID.
# Status: Obrigatório
# Exemplo: 111111111111111111, 222222222222222222
CARGO_SEGURANÇA_ID=000000000000000000


# ==============================================================================
# CONFIGURAÇÕES OPCIONAIS
# ==============================================================================
# NOTA: Se deixar essas variáveis vazias, o bot ainda vai funcionar, mas o 
# respectivo módulo poderá ficar desabilitado ou utilizar configurações padrão.

# ID do cargo secundário que também tem permissão para advertir e exonerar, sem ser Admin.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo e escolha Copiar ID.
# Status: Opcional (se deixar vazio, apenas Admin poderá fazer isso)
# Exemplo: 123456789012345678
PERM_ADVERTENCIA_ROLE_ID=000000000000000000

# ID do canal onde os registros aguardam aprovação de um recrutador.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CANAL_APROVACAO_REGISTRO_ID=000000000000000000

# ID do canal onde ficam registrados (logs) os advogados/seguranças aprovados ou recusados.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CANAL_LOGS_REGISTRO_ID=000000000000000000

# ID do canal público ou de aviso onde as advertências são anunciadas para o staff.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CANAL_PENALIDADES_ID=000000000000000000

# ID do canal de Logs exclusivo para registro de advertências internas (histórico).
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CANAL_LOGS_ADV_ID=000000000000000000

# ID do cargo de Exonerado, entregue aos membros quando são demitidos.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no cargo e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CARGO_EXONERADO_ID=000000000000000000

# ID do canal público onde a mensagem de exoneração é anunciada.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CANAL_EXONERACAO_ID=000000000000000000

# ID do canal interno para consultar membros em Blacklist.
# Onde encontrar: Ative o Modo Desenvolvedor em Configurações > Avançado, clique com o botão direito no canal e escolha Copiar ID.
# Status: Opcional
# Exemplo: 123456789012345678
CANAL_BLACKLIST_ID=000000000000000000
